# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env n'est jamais commité.

# --- Chemins (optionnels : par défaut tout est sous ./data) ---
# OLIST_DATA_DIR=data
# OLIST_RAW_DIR=data/raw
# OLIST_CACHE_DIR=data/cache
# OLIST_DUCKDB_PATH=data/olist.duckdb

# --- Reproductibilité et logs ---
RANDOM_SEED=42
LOG_LEVEL=INFO

# --- LLM (utilisés à partir de l'étape 5) ---
# Fournisseur actif : groq (par défaut, offre gratuite sans carte) ou mistral
# (en novembre 2026, l'API Mistral exige des crédits prépayés)
LLM_PROVIDER=groq
GROQ_API_KEY=
MISTRAL_API_KEY=
# Modèles (optionnels ; les noms évoluent, vérifier la liste du fournisseur)
# GROQ_MODEL=openai/gpt-oss-120b
# MISTRAL_MODEL=mistral-small-latest
# Pause minimale entre deux appels, en secondes (offres gratuites limitées par minute)
# LLM_MIN_INTERVAL_S=1.5
