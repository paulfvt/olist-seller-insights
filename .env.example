# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env n'est jamais commité.

# --- Chemins (optionnels : par défaut tout est sous ./data) ---
# OLIST_DATA_DIR=data
# OLIST_RAW_DIR=data/raw
# OLIST_CACHE_DIR=data/cache
# OLIST_DUCKDB_PATH=data/olist.duckdb

# --- Reproductibilité et logs ---
RANDOM_SEED=42
LOG_LEVEL=INFO

# --- LLM (utilisés à partir de l'étape 5) ---
# Fournisseur actif : mistral (plan A) ou groq (plan B)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
GROQ_API_KEY=
